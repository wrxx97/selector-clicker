{
  "name": "selector-clicker",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "Selector Clicker browser extension.",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite build --config src/build/vite.config.ts --watch",
